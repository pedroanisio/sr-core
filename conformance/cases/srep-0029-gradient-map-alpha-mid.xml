<?xml version="1.0" encoding="UTF-8"?>
<!-- SREP 29 s3, an interior position (assumptions A1 and A2, stated because the SREP leaves them to the baseline effect: A1 the mapped position is the display-encoded luma, so the flat #808080 patch sits at 128/255 = 0.50196; A2 with linearLight=false the over-compositing of the result on the blue background is done on display-encoded values). Map 1 alpha = 1 - 0.50196 = 0.49804: R = 255a = 127.0, B = 255(1-a) = 128.0. Map 2 alpha = 0.50196: R = 128.0, B = 127.0. The stop alpha is interpolated linearly between the stops. Engine provenance: measured on rs-scene-render vendor/schema-1.3 build 2d9eb13d (binary sha256 prefix 4be4bebe002bc190), llvmpipe, frame 0 (render -f 0), VM style1; the expected values were derived from the SREP formulas first (script model) and then compared with the render. Proposals until re-verified on the vendoring commit. -->
<scene version="1.2">
<project width="640" height="360" fps="24" duration="1" background="#0000FFFF" linearLight="false"/>
<output id="still" path="out/frame_%04d.png" codec="png-sequence"/>
<paints><linearGradient id="g1"><stop offset="0" color="#FF0000FF"/><stop offset="1" color="#FF000000"/></linearGradient><linearGradient id="g2"><stop offset="0" color="#FF000000"/><stop offset="1" color="#FF0000FF"/></linearGradient></paints>
<materials><material id="m-red" baseColor="#FF0000FF" unlit="true" doubleSided="true"/><material id="m-green" baseColor="#00FF00FF" unlit="true" doubleSided="true"/><material id="m-blue" baseColor="#0000FFFF" unlit="true" doubleSided="true"/><material id="m-yellow" baseColor="#FFFF00FF" unlit="true" doubleSided="true"/></materials>
<composition>
<shape id="p01" shape="rect" width="100" height="80" x="220" y="40" fill="#808080FF" effects="e1"/>
<shape id="p11" shape="rect" width="100" height="80" x="220" y="200" fill="#808080FF" effects="e2"/>
</composition>
<effects>
<effect id="e1" type="gradient-map" paint="url(#g1)"/>
<effect id="e2" type="gradient-map" paint="url(#g2)"/>
</effects>
</scene>
