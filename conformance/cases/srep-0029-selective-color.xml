<?xml version="1.0" encoding="UTF-8"?>
<!-- SREP 29 s2 selective-color, @color red (hue 0 degrees) with @saturation=0, @amount default 1, @tolerance default 0.2: window half-width 0.1 turn (36 degrees) with the smoothstep edge to 0.15. #FF0000 (S=1, V=1) gives S'=0: (255,255,255), WHITE, not grey: V is 1, so desaturating a pure red gives white (the SREP's Conformance row says grey; the row is loose, the formula decides). #B40000 (V=180/255) gives (180,180,180) grey. #B45A00 (hue 30, d=0.0833 inside the full window) gives (180,180,180). #00B400 (hue 120, d=0.3333 > 0.15, w=0) is unchanged (0,180,0). Engine provenance: measured on rs-scene-render vendor/schema-1.3 build 2d9eb13d (binary sha256 prefix 4be4bebe002bc190), llvmpipe, frame 0 (render -f 0), VM style1; the expected values were derived from the SREP formulas first (script model) and then compared with the render. Proposals until re-verified on the vendoring commit. -->
<scene version="1.2">
<project width="640" height="360" fps="24" duration="1" background="#000000FF"/>
<output id="still" path="out/frame_%04d.png" codec="png-sequence"/>
<materials><material id="m-red" baseColor="#FF0000FF" unlit="true" doubleSided="true"/><material id="m-green" baseColor="#00FF00FF" unlit="true" doubleSided="true"/><material id="m-blue" baseColor="#0000FFFF" unlit="true" doubleSided="true"/><material id="m-yellow" baseColor="#FFFF00FF" unlit="true" doubleSided="true"/></materials>
<composition>
<shape id="b0" shape="rect" width="80" height="80" x="40" y="100" fill="#FF0000FF" effects="e"/>
<shape id="b1" shape="rect" width="80" height="80" x="160" y="100" fill="#B40000FF" effects="e"/>
<shape id="b2" shape="rect" width="80" height="80" x="280" y="100" fill="#00B400FF" effects="e"/>
<shape id="b3" shape="rect" width="80" height="80" x="400" y="100" fill="#B45A00FF" effects="e"/>
</composition>
<effects>
<effect id="e" type="selective-color" color="#FF0000FF" saturation="0"/>
</effects>
</scene>
