<?xml version="1.0" encoding="UTF-8"?>
<!-- SREP 29 s2 step 1: when @color is given it wins over @hue. The effect has @color red and @hue=120: the window is centred on red (0 degrees), so #B40000 goes grey (180,180,180) and #00B400 (hue 120, the window of @hue) is unchanged (0,180,0). Engine provenance: measured on rs-scene-render vendor/schema-1.3 build 2d9eb13d (binary sha256 prefix 4be4bebe002bc190), llvmpipe, frame 0 (render -f 0), VM style1; the expected values were derived from the SREP formulas first (script model) and then compared with the render. Proposals until re-verified on the vendoring commit. -->
<scene version="1.2">
<project width="640" height="360" fps="24" duration="1" background="#000000FF"/>
<output id="still" path="out/frame_%04d.png" codec="png-sequence"/>
<materials><material id="m-red" baseColor="#FF0000FF" unlit="true" doubleSided="true"/><material id="m-green" baseColor="#00FF00FF" unlit="true" doubleSided="true"/><material id="m-blue" baseColor="#0000FFFF" unlit="true" doubleSided="true"/><material id="m-yellow" baseColor="#FFFF00FF" unlit="true" doubleSided="true"/></materials>
<composition>
<shape id="b0" shape="rect" width="80" height="80" x="40" y="100" fill="#B40000FF" effects="e"/>
<shape id="b1" shape="rect" width="80" height="80" x="160" y="100" fill="#00B400FF" effects="e"/>
</composition>
<effects>
<effect id="e" type="selective-color" color="#FF0000FF" hue="120" saturation="0"/>
</effects>
</scene>
