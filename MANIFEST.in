# The sdist is the complete source release: the canonical schema, its generated reference, the SREPs, the
# release tooling and the tests all ship, so the tests pass from an unpacked sdist.
include LICENSE README.md CHANGELOG.md
# tests/test_drift_p2.py compares the dependencies CI installs with the extras and the tests' imports
include .github/workflows/ci.yml
graft schema
graft docs
graft srep
graft tools
graft tests
graft conformance
prune conformance/out
global-exclude __pycache__ *.py[cod]
